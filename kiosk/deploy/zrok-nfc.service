[Unit]
Description=zrok tunnel for Dasibom NFC reader (127.0.0.1:5000 -> https://__SHARE__.shares.zrok.io)
Documentation=https://docs.zrok.io
# 리더기 서버가 먼저 떠 있어야 터널이 붙일 대상이 생긴다
After=network-online.target nfc-server.service
Wants=network-online.target

# 부팅 직후 네트워크가 아직 안 잡혔을 때를 대비한 재시도 허용치
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=__USER__
# zrok 는 ~/.zrok 에 있는 환경 설정을 읽으므로 HOME 이 반드시 필요하다
Environment=HOME=__HOME__
# --headless: 터미널 UI 없이 로그만 남기고 백그라운드로 계속 돈다
ExecStart=__ZROK__ share reserved __SHARE__ --headless

# 터널이 끊겨도(공유기 재부팅, 인터넷 순단 등) 다시 붙는다
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
